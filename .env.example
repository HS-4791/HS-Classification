# Copy to .env and fill in. Never commit .env.

# --- schedule version: a classification is only valid against one ---
# Set from the USITC release actually downloaded (see `hsclass schedule fetch`).
HTS_REVISION=2026HTSRev21

# --- model providers (stage 1 normalise, stage 4 explain) ---
# Stage 3 adjudicate uses no model and needs no key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- embeddings ---
# local = sentence-transformers on CPU, no key, deterministic
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- guardrails ---
COST_CEILING_USD_PER_REQUEST=0.05
